APP_ENV=local
DOORMAN_ADMIN_USER=admin
# Required when creating or resetting the admin; 12 to 72 bytes.
DOORMAN_ADMIN_PASSWORD=
# Generate with: openssl rand -hex 32
DOORMAN_SESSION_SECRET=
PORT=8080
DB_PROVIDER=sqlite
DB_PATH=analytics.db
DOORMAN_RETENTION_DAYS=90
# Hard ceiling across all retained visits; heartbeats continue at capacity.
DOORMAN_MAX_PAGE_VIEWS=1000000
# Required in production. Hostnames only, separated by commas.
DOORMAN_ALLOWED_HOSTS=example.com
# Trust only the CIDR ranges used by your reverse proxy.
DOORMAN_TRUSTED_PROXIES=
# Optional commercial HTTPS geolocation; disabled when empty.
DOORMAN_GEO_API_KEY=
# Optional separate 32+ byte bearer token for metrics scrapers.
DOORMAN_METRICS_TOKEN=

# For postgres or mysql, use DATABASE_URL or the individual settings.
# DATABASE_URL=postgres://user:password@localhost:5432/dbname?sslmode=verify-full
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=user
# DB_PASSWORD=
# DB_NAME=dbname
# DB_SSLMODE=verify-full
