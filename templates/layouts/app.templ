package layouts

templ AppLayout(title string) {
	@Base(title) {
		<a class="skip-link" href="#main">Skip to content</a>
		<header class="masthead">
			@Brand()
			<div class="masthead-meta"><span class="edition">YOUR TRAFFIC, ACCOUNTED FOR.</span><form action="/logout" method="post"><button class="text-button" type="submit">Sign out <span aria-hidden="true">↗</span></button></form></div>
		</header>
		{ children... }
		@Footer()
	}
}
