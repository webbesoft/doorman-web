package layouts

templ AuthLayout(title string) {
	@Base(title) {
		<div class="auth-shell">
			<header class="masthead">
				@Brand()
				<span class="edition">SMALL FOOTPRINT. CLEAR PICTURE.</span>
			</header>
			<main id="main" class="auth-main">
				{ children... }
			</main>
			@Footer()
		</div>
	}
}
