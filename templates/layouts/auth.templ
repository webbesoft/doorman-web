package layouts

templ AuthLayout(title string) {
	@Base(title) {
		<body class="min-h-screen">
			<div class="flex min-h-screen">
				// Left side - Form content
				<div class="w-full lg:w-1/2 flex flex-col justify-between px-8 lg:px-16 py-12 bg-white">
					<div class="w-full max-w-lg mx-auto">
						{ children... }
					</div>
					<div class="mt-8 text-center">
						<p class="text-sm text-gray-500">
							Doorman Analytics &copy; 2025 &middot; <a href="https://github.com/webbesoft/doorman-web" class="hover:text-indigo-600 transition duration-150">Github</a>
						</p>
					</div>
				</div>
				// Right side - Branding
				<div class="hidden lg:flex lg:w-1/2 bg-indigo-600 text-white">
					<div class="flex flex-col justify-center px-16 w-full max-w-lg mx-auto">
						<div class="mb-8">
							<div class="inline-block p-4 bg-indigo-500 rounded-2xl">
								<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
								</svg>
							</div>
						</div>
						<h2 class="text-4xl font-bold mb-6">Doorman Analytics</h2>
						<p class="text-xl text-indigo-200 leading-relaxed">Monitor and analyze your traffic patterns with sophisticated, real-time analytics and insights.</p>
						<div class="mt-12 space-y-4">
							<div class="flex items-center space-x-4">
								<div class="shrink-0">
									<svg class="w-6 h-6 text-indigo-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
									</svg>
								</div>
								<span class="text-indigo-200">Real-time visitor tracking</span>
							</div>
							<div class="flex items-center space-x-4">
								<div class="shrink-0">
									<svg class="w-6 h-6 text-indigo-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
									</svg>
								</div>
								<span class="text-indigo-200">Advanced analytics</span>
							</div>
							<div class="flex items-center space-x-4">
								<div class="shrink-0">
									<svg class="w-6 h-6 text-indigo-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
									</svg>
								</div>
								<span class="text-indigo-200">Geolocation insights</span>
							</div>
						</div>
					</div>
				</div>
			</div>
		</body>
	}
}
