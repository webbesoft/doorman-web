package pages

import "github.com/webbesoft/doorman/templates/layouts"

templ LoginPage(err string) {
	@layouts.AuthLayout("Sign in") {
		<section class="entry" aria-labelledby="entry-title">
			<div class="entry-spine" aria-hidden="true"><span>DOORMAN / PRIVATE ENTRANCE</span><span>01</span></div>
			<div class="entry-content">
				<p class="eyebrow"><span class="square"></span> The visitor ledger</p>
				<h1 id="entry-title">You’re at the<br/>right door.</h1>
				<p class="entry-intro">Sign in for a closer look at the people<br class="desktop-break"/> finding their way to your website.</p>
				if err != "" {
					<div class="form-error" role="alert">{ err }</div>
				}
				<form action="/login" method="post" class="login-form">
					<div class="field"><label for="username"><span>01</span> Username</label><input id="username" type="text" name="username" autocomplete="username" required placeholder="Your username" autocapitalize="none" spellcheck="false"/></div>
					<div class="field"><label for="password"><span>02</span> Password</label><input id="password" type="password" name="password" autocomplete="current-password" required placeholder="Your password"/></div>
					<button class="entry-button" type="submit">Enter dashboard <span aria-hidden="true">↗</span></button>
				</form>
				<p class="entry-note">A count of visits. A respect for privacy.<br/>Lightweight analytics, on your own terms.</p>
			</div>
		</section>
	}
}
